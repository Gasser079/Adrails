{
  "name": "adrails-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ADRAILS_API_VERSION": "v25"
  },
  "d1_databases": [
    { "binding": "LEDGER_DB", "database_name": "adrails-ledger", "database_id": "REPLACE_WITH_D1_ID" }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "REPLACE_WITH_KV_ID" }
  ],
  "queues": {
    "producers": [{ "binding": "EXECUTION_QUEUE", "queue": "adrails-execution" }]
  },
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "SEMANTIC_INDEX", "index_name": "adrails-semantic" }
  ]
}
